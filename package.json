{
  "name": "sz-sso-client-web-sdk",
  "version": "2.0.0",
  "description": "SSO Client Web SDK - 前端快速接入单点登录",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.mjs",
      "require": "./dist/vue.cjs"
    },
    "./style.css": "./dist/sz-sso-client-web-sdk.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {},
  "peerDependencies": {
    "element-plus": "^2.0.0",
    "vue": "^3.3.0",
    "vue-router": ">=4.2.0 <6"
  },
  "peerDependenciesMeta": {
    "element-plus": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "vue-router": {
      "optional": true
    }
  },
  "devDependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "element-plus": "^2.10.1",
    "typescript": "~5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.3.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0",
    "vue-tsc": "^2.2.0"
  },
  "keywords": [
    "sso",
    "single-sign-on",
    "auth",
    "sdk",
    "vue3"
  ],
  "license": "MIT"
}
